# Copy these values into the Dokploy Compose service's Environment settings.
# Dokploy writes .env for api.env_file; use internal PostgreSQL/Redis service DNS.
IMAGE_TAG=main
DATABASE_URL=postgresql://studio:URL_ENCODED_PASSWORD@POSTGRES_SERVICE:5432/skycanvasstudio
REDIS_URL=redis://:URL_ENCODED_PASSWORD@REDIS_SERVICE:6379
REDIS_KEY_PREFIX=skycanvasstudio:

# Public browser configuration: also set matching GitHub Actions variables.
VITE_SERVER_URL=https://api.example.com
VITE_ENABLE_POLAR=false
VITE_OWNER_SETUP_CHECK=false
AUTH_SESSION_COOKIE_NAME=skycanvasstudio.session_token

# Runtime API/auth configuration. Generate a fresh secret: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://api.example.com
CORS_ORIGIN=https://example.com
# For sibling web/API subdomains; replace with your own shared domain.
# AUTH_COOKIE_DOMAIN=.example.com

# The retained starter currently requires all three OAuth pairs at startup.
# These are OAuth credentials, not GitHub/Docker registry personal access tokens.
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_OAUTH_CLIENT_SECRET
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_OAUTH_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_OAUTH_CLIENT_SECRET

ENABLE_POLAR=false
OWNER_SETUP_CHECK=false
POLAR_MODE=production
# Configure SMTP for verification, password resets, magic links, and invitations.
SMTP_HOST=
SMTP_PORT=587
EMAIL=
EMAIL_PASSWORD=
EMAIL_FROM=SkyCanvas Studio
# Used only by the explicit owner-provisioning command.
OWNER_EMAIL=
OWNER_NAME=
# Add these only when enabling and configuring payments.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SUCCESS_URL=https://example.com/payment/success?checkout_id={CHECKOUT_ID}
# POLAR_PRO_MONTHLY_ID=
# POLAR_PRO_YEARLY_ID=
